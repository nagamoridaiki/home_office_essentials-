# cp .env.example .env で .env を作って使う（.env はコミットしない）
# ローカル開発専用のダミー値。本番では使わない

# PostgreSQL（db）
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=home_office_essentials

# api の接続先（DATABASE_URL）は、上の値から compose.yaml で組み立てて渡している。
# ここに直接書く必要はない

# ログイン Cookie の Secure 属性（api）。
# false にすると Secure を外す。ローカルで Cookie が保存されないときだけ使う
SESSION_COOKIE_SECURE=true
